
-- table stores the forms that are created. Contains unique form ID and non unique name.
CREATE TABLE SampleForm (
    form_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_name TEXT NOT NULL
);

insertSampleForm:
INSERT INTO SampleForm(form_name)
VALUES(?);

getAllSampleForms:
SELECT * FROM SampleForm;

getSampleForm:
SELECT * FROM SampleForm WHERE form_id = ?;

-- table stores fields assocaited with each form, form_id links the fields to their form
CREATE TABLE Field (
    field_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_id INTEGER NOT NULL,
    field_name TEXT NOT NULL,
    order_num INTEGER NOT NULL,         -- the order of the field within the form
    field_type TEXT NOT NULL,
    is_required INTEGER DEFAULT 0,
    options TEXT,              -- like ["Red", "Green", "Blue"]
    FOREIGN KEY (form_id) REFERENCES SampleForm(form_id) ON DELETE CASCADE
);

insertField:
INSERT INTO Field(form_id, field_name, order_num, field_type, is_required, options)
VALUES(?,?,?,?,?,?);

getFormFields:
SELECT * FROM Field WHERE form_id = ? ORDER BY order_num ASC;

getFieldByID:
SELECT * FROM Field WHERE field_id = ?;

changeFieldOrder:
UPDATE Field SET order_num = ? WHERE field_id = ?;

--table stores samples collected (additional sample data stored in dataEntry table, linked to sampleData)
CREATE TABLE SampleData (
    sample_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_id INTEGER NOT NULL,
    date_collected_utc TEXT NOT NULL,
    location TEXT NOT NULL,
    FOREIGN KEY (form_id) REFERENCES SampleForm(form_id) ON DELETE CASCADE
);

insertSampleData:
INSERT INTO SampleData(form_id, date_collected_utc, location)
VALUES(?,?,?);

getAllSampleData:
SELECT * FROM SampleData;

getSampleDataByForm:
SELECT * FROM SampleData WHERE form_id = ?;

getSampleData:
SELECT * FROM SampleData WHERE sample_id = ?;

--data entries stored here. this is an INDIVIDUAL data entry.
--sample ID links it to specific sample taken
--field ID links to type of field (specifies field attributes)
--user input is actual data stored in field. any data type must be stored as string in here and transcribed using fieldType from field ID
CREATE TABLE DataEntry (
    entry_id INTEGER PRIMARY KEY AUTOINCREMENT,
    sample_id INTEGER NOT NULL,
    field_id INTEGER NOT NULL,
    user_input TEXT NOT NULL,
    FOREIGN KEY (sample_id) REFERENCES SampleData(sample_id) ON DELETE CASCADE,
    FOREIGN KEY (field_id) REFERENCES Field(field_id) ON DELETE CASCADE
);

insertDataEntry:
INSERT INTO DataEntry(sample_id, field_id, user_input)
VALUES(?,?,?);

getDataEntry:
SELECT * FROM DataEntry WHERE sample_id = ?;

getLastRowID:
SELECT last_insert_rowid();

clearAllDataEntries:
DELETE FROM DataEntry;

clearAllSamples:
DELETE FROM SampleData;

deleteDataEntryBySampleId:
DELETE FROM DataEntry WHERE sample_id = ?;
deleteSample:
DELETE FROM SampleData WHERE sample_id = ?;

updateSampleData:
UPDATE SampleData
SET date_collected_utc = ?,
    location = ?
WHERE sample_id = ?;

updateDataEntry:
UPDATE DataEntry
SET user_input = ?
WHERE sample_id = ?
  AND field_id = ?;

