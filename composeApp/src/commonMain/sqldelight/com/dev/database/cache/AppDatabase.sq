
-- New table for storing images related to samples
CREATE TABLE SampleImages (
    image_id INTEGER PRIMARY KEY AUTOINCREMENT,
    sample_id INTEGER NOT NULL,
    image_data BLOB NOT NULL,         -- To store the actual image bytes
    image_name TEXT,                   -- Optional name for the image
    image_type TEXT,                   -- Store the MIME type (e.g., "image/jpeg")
    timestamp TEXT NOT NULL,           -- When the image was added
    FOREIGN KEY (sample_id) REFERENCES SampleData(sample_id) ON DELETE CASCADE
);

CREATE TABLE Settings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

-- Insert or replace a setting
insertOrReplaceSetting:
INSERT OR REPLACE INTO Settings (key, value)
VALUES(?, ?);

getSettingByKey:
SELECT value FROM Settings
WHERE key = ?;

-- Insert a new image
insertSampleImage:
INSERT INTO SampleImages(sample_id, image_data, image_name, image_type, timestamp)
VALUES(?, ?, ?, ?, ?);

-- Get all images for a sample
getSampleImages:
SELECT * FROM SampleImages WHERE sample_id = ? ORDER BY timestamp DESC;

-- Get a specific image
getImageById:
SELECT * FROM SampleImages WHERE image_id = ?;

-- Delete an image
deleteSampleImage:
DELETE FROM SampleImages WHERE image_id = ?;

updateImageSampleId:
UPDATE SampleImages SET sample_id = ? WHERE sample_id = ?;

-- Delete all images for a sample
deleteAllSampleImages:
DELETE FROM SampleImages WHERE sample_id = ?;

-- table stores the forms that are created. Contains unique form ID and non unique name.
CREATE TABLE SampleForm (
    form_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_name TEXT NOT NULL,
    form_active INTEGER NOT NULL DEFAULT 1
);

insertSampleForm:
INSERT INTO SampleForm(form_name, form_active)
VALUES(?,?);

getAllSampleForms:
SELECT * FROM SampleForm WHERE form_active = 1;

getSampleForm:
SELECT * FROM SampleForm WHERE form_id = ?;

-- table stores fields assocaited with each form, form_id links the fields to their form
CREATE TABLE Field (
    field_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_id INTEGER NOT NULL,
    field_name TEXT NOT NULL,
    order_num INTEGER NOT NULL,         -- the order of the field within the form
    field_type TEXT NOT NULL,
    is_required INTEGER DEFAULT 0,
    options TEXT,              -- like ["Red", "Green", "Blue"]
    FOREIGN KEY (form_id) REFERENCES SampleForm(form_id) ON DELETE CASCADE
);

insertField:
INSERT INTO Field(form_id, field_name, order_num, field_type, is_required, options)
VALUES(?,?,?,?,?,?);

getFormFields:
SELECT * FROM Field WHERE form_id = ? ORDER BY order_num ASC;

getFieldByID:
SELECT * FROM Field WHERE field_id = ?;

changeFieldOrder:
UPDATE Field SET order_num = ? WHERE field_id = ?;

--table stores samples collected (additional sample data stored in dataEntry table, linked to sampleData)
CREATE TABLE SampleData (
    sample_id INTEGER PRIMARY KEY AUTOINCREMENT,
    form_id INTEGER NOT NULL,
    sample_collection_id INTEGER NOT NULL,
    collector_name TEXT NOT NULL,      -- NEW column for the collector’s name
    date_collected_utc TEXT NOT NULL,
    location TEXT NOT NULL,
    FOREIGN KEY (form_id) REFERENCES SampleForm(form_id) ON DELETE CASCADE
);

insertSampleData:
INSERT INTO SampleData(form_id, sample_collection_id, collector_name, date_collected_utc, location)
VALUES(?,?,?,?,?);

getAllSampleData:
SELECT
  sample_id,
  form_id,
  sample_collection_id,
  collector_name,
  date_collected_utc,
  location
FROM SampleData;

getSampleDataByForm:
SELECT
  sample_id,
  form_id,
  sample_collection_id,
  collector_name,
  date_collected_utc,
  location
FROM SampleData
WHERE form_id = ?;

getSampleData:
SELECT
  sample_id,
  form_id,
  sample_collection_id,
  collector_name,
  date_collected_utc,
  location
FROM SampleData
WHERE sample_id = ?;

getMaxCollectionIdByForm:
SELECT CAST(MAX(sample_collection_id) AS INTEGER) AS max_local_id
FROM SampleData
WHERE form_id = ?;

--data entries stored here. this is an INDIVIDUAL data entry.
--sample ID links it to specific sample taken
--field ID links to type of field (specifies field attributes)
--user input is actual data stored in field. any data type must be stored as string in here and transcribed using fieldType from field ID
CREATE TABLE DataEntry (
    entry_id INTEGER PRIMARY KEY AUTOINCREMENT,
    sample_id INTEGER NOT NULL,
    field_id INTEGER NOT NULL,
    user_input TEXT NOT NULL,
    FOREIGN KEY (sample_id) REFERENCES SampleData(sample_id) ON DELETE CASCADE,
    FOREIGN KEY (field_id) REFERENCES Field(field_id) ON DELETE CASCADE
);

insertDataEntry:
INSERT INTO DataEntry(sample_id, field_id, user_input)
VALUES(?,?,?);

getDataEntry:
SELECT * FROM DataEntry WHERE sample_id = ?;

getLastRowID:
SELECT last_insert_rowid();

clearAllDataEntries:
DELETE FROM DataEntry;

clearAllSamples:
DELETE FROM SampleData;

deleteDataEntryBySampleId:
DELETE FROM DataEntry WHERE sample_id = ?;
deleteSample:
DELETE FROM SampleData WHERE sample_id = ?;

updateSampleData:
UPDATE SampleData
SET collector_name = ?,
    date_collected_utc = ?,
    location = ?
WHERE sample_id = ?;

updateDataEntry:
UPDATE DataEntry
SET user_input = ?
WHERE sample_id = ?
  AND field_id = ?;

